# syntax=docker/dockerfile:1

# Build stage
FROM python:3.14-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    POETRY_VERSION=2.2.0 \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_NO_INTERACTION=1

WORKDIR /app

RUN pip install "poetry==${POETRY_VERSION}"

# deps layer
COPY pyproject.toml poetry.lock* ./
RUN poetry install --no-root --only main --no-ansi

# Final stage
FROM python:3.14-slim

LABEL io.modelcontextprotocol.server.name="io.github.vulnersCom/vulners-mcp"
ENV FASTMCP_HOST=0.0.0.0
ENV FASTMCP_PORT=8000
ENV FAST_MCP_HOST=0.0.0.0

WORKDIR /app

# Copy installed packages from builder stage (excluding pip and other build tools)
COPY --from=builder /usr/local/lib/python3.14/site-packages /usr/local/lib/python3.14/site-packages
# Only copy python binary, not pip or other install tools
COPY --from=builder /usr/local/bin/python* /usr/local/bin/

# Remove pip package and other installation tools from final image
RUN rm -rf /usr/local/lib/python3.14/site-packages/pip* \
    && rm -f /usr/local/bin/pip* /usr/local/bin/poetry*

# app layer
COPY vulners_mcp ./vulners_mcp

# non-root
RUN useradd -u 10001 -m appuser
USER appuser

EXPOSE 8000

# Start the FastMCP server (Streamable HTTP at /mcp/)
CMD ["python", "-m", "vulners_mcp"]
